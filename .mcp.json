{
  "mcpServers": {
    "bongbong": {
      "command": "bash",
      "args": [
        "tools/dev/bbmcp.sh"
      ],
      "env": {
        "BONGBONG_DEV_PORT": "4747"
      }
    },
    "bongbong-rooms": {
      "command": "bash",
      "args": [
        "tools/dev/bbmcp.sh",
        "rooms"
      ],
      "env": {
        "BONGBONG_ROOMS_DEV_PORT": "4849"
      }
    }
  }
}
