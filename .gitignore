**/.DS_*

.envrc

# Python (tools/spritegen, tools/resurrect64.py)
__pycache__/
*.pyc

# Claude Code worktrees (local, per-session checkouts)
.claude/worktrees/

# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml
# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

.idea/

# Generated by .github/workflows/pr-preview.yml in CI (per-PR wrangler config)
wrangler.preview.toml
