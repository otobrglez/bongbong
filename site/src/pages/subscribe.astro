---
// The newsletter on a page of its own, for links that still point here;
// the game page carries the same form below the game (index.astro
// `#updates`).
import Page from "../layouts/Page.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import Bongs from "../components/Bongs.astro";
---

<Page title="Subscribe for updates" description="Get an email when a new version of BongBong ships." band="oasis">
    <h1>Get updates</h1>
    <div class="panel">
        <h2>Get a dispatch when a new version ships</h2>
        <p class="lead">New tanks, new maps, new ways to blow things up.</p>
        <NewsletterForm id="subscribe"/>
        <Bongs/>
    </div>
</Page>

<script src="../scripts/subscribe.ts"></script>

<style lang="scss">
  .panel {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 28px;
    padding: 24px 24px 0;
    background: var(--grass-panel);
    border: 1px solid var(--grass-line);
    border-radius: 12px;

    h2 {
      margin: 0;
      font-size: 22px;
    }
  }

  .lead {
    margin: 0;
    color: var(--grass-text);
  }
</style>
