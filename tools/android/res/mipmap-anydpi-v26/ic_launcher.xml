<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon: an adaptive icon whose two layers
     tools/android/gen_app_icon.py draws into the mipmap-<density>/
     directories beside this one. tools/android/package.sh compiles the
     res/ tree in and the manifest names it as @mipmap/ic_launcher. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
